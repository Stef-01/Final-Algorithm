{
  "name": "watl",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vercel/analytics": "^2.0.1",
    "expo": "~57.0.25",
    "expo-calendar": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "lockfile": "rm -rf node_modules package-lock.json && npm install",
    "test:py": "python3 -m unittest discover scripts/tests",
    "budget": "expo export --platform web && node scripts/check-budget.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.jsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@server/(.*)$": "<rootDir>/server/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/legacy-android/"
    ]
  },
  "engines": {
    "node": "22.x"
  }
}
